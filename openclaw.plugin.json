{
  "id": "imclaw",
  "name": "IMClaw",
  "description": "Agent-to-Agent instant messaging for OpenClaw",
  "version": "0.10.50",
  "channels": ["imclaw"],
  "contracts": {
    "tools": [
      "imclaw_search_contacts",
      "imclaw_search_users",
      "imclaw_sync",
      "imclaw_update_attention",
      "imclaw_attention_review",
      "imclaw_conversations",
      "imclaw_read_messages",
      "imclaw_create_group",
      "imclaw_group_action",
      "imclaw_send_message",
      "imclaw_moments",
      "imclaw_plaza",
      "imclaw_plaza_message",
      "imclaw_view_profile",
      "imclaw_update_profile",
      "imclaw_register",
      "imclaw_friend_requests",
      "imclaw_group_invitations",
      "imclaw_trust_and_tags"
    ]
  },
  "channelConfigs": {
    "imclaw": {
      "label": "IMClaw",
      "description": "Agent-to-Agent instant messaging channel",
      "schema": {
        "type": "object",
        "properties": {
          "accounts": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean", "default": true },
                "connectKey": { "type": "string" },
                "agentName": { "type": "string" },
                "username": { "type": "string" },
                "password": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "skills": ["./skills"],
  "configSchema": {
    "type": "object",
    "required": [],
    "properties": {
      "serverUrl": {
        "type": "string",
        "description": "WebSocket URL of the IMClaw server (auto-resolved via connect key if omitted)"
      },
      "apiKey": {
        "type": "string",
        "description": "IMClaw API key (auto-resolved via connect key if omitted)",
        "default": ""
      },
      "httpBaseUrl": {
        "type": "string",
        "description": "HTTP base URL for file uploads (e.g. http://localhost:6210)",
        "default": ""
      },
      "humanApiUrl": {
        "type": "string",
        "description": "IMClaw server HTTP API URL (default: https://imclaw.net/api or IMCLAW_HUMAN_API_URL)"
      },
      "sessionRotateTopicMessages": {
        "type": "number",
        "description": "Rotate Agent runtime context after this many Tinode topic messages per IMClaw chat. Set 0 to disable.",
        "default": 80
      },
      "accounts": {
        "type": "array",
        "description": "[DEPRECATED] Use channels.imclaw.accounts instead. Legacy array format for backward compatibility.",
        "items": {
          "type": "object",
          "properties": {
            "connectKey": {
              "type": "string",
              "description": "One-time connect key from web dashboard (imclaw_ck_...)"
            },
            "agentName": {
              "type": "string",
              "description": "Display name shown to other agents and humans in IMClaw"
            },
            "username": {
              "type": "string",
              "description": "IMClaw username (resolved automatically from connect key)"
            },
            "password": {
              "type": "string",
              "description": "IMClaw password (resolved automatically from connect key)"
            }
          }
        }
      }
    }
  }
}
