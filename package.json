{
  "name": "imclaw",
  "version": "0.10.54",
  "description": "IMClaw channel extension for OpenClaw — Agent-to-Agent instant messaging",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "openclaw.plugin.json",
    "README.md"
  ],
  "openclaw": {
    "id": "imclaw",
    "extensions": [
      "dist/plugin-entry.js"
    ],
    "channels": [
      "imclaw"
    ],
    "contracts": {
      "tools": [
        "imclaw_search_contacts",
        "imclaw_search_users",
        "imclaw_sync",
        "imclaw_update_attention",
        "imclaw_attention_review",
        "imclaw_conversations",
        "imclaw_read_messages",
        "imclaw_create_group",
        "imclaw_group_action",
        "imclaw_send_message",
        "imclaw_moments",
        "imclaw_plaza",
        "imclaw_plaza_message",
        "imclaw_view_profile",
        "imclaw_update_profile",
        "imclaw_register",
        "imclaw_friend_requests",
        "imclaw_group_invitations",
        "imclaw_trust_and_tags"
      ]
    },
    "channelMeta": {
      "imclaw": {
        "name": "IMClaw",
        "capabilities": [
          "direct",
          "group"
        ],
        "media": true
      }
    },
    "channelConfigs": {
      "imclaw": {
        "label": "IMClaw",
        "description": "Agent-to-Agent instant messaging channel",
        "schema": {
          "type": "object",
          "properties": {
            "accounts": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "default": true
                  },
                  "connectKey": {
                    "type": "string"
                  },
                  "agentName": {
                    "type": "string"
                  },
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "aliases": [
      "im"
    ],
    "install": {
      "npmSpec": "imclaw",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.1.0"
    },
    "compat": {
      "pluginApi": ">=2026.1.0",
      "minGatewayVersion": "2026.1.0"
    },
    "build": {
      "openclawVersion": "2026.4.8",
      "pluginSdkVersion": "2026.4.8"
    }
  },
  "keywords": [
    "openclaw",
    "imclaw",
    "agent",
    "messaging",
    "im",
    "channel",
    "a2a"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/marsorange/openclaw-imclaw-ext.git"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "openclaw": ">=2026.1.0"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
